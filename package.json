{
  "name": "@aidc-toolkit/app-extension",
  "version": "2.0.0-alpha",
  "description": "Application extension framework for AIDC Toolkit",
  "keywords": [
    "aidc",
    "barcode",
    "rfid",
    "epc",
    "microsoft",
    "word",
    "excel",
    "powerpoint",
    "google",
    "docs",
    "sheets",
    "slides"
  ],
  "type": "module",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./gs1": "./dist/gs1/index.js",
    "./generator": "./dist/generator/index.js"
  },
  "homepage": "https://aidc-toolkit.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aidc-toolkit/app-extension.git"
  },
  "bugs": {
    "url": "https://github.com/aidc-toolkit/app-extension/issues"
  },
  "license": "Apache-2.0",
  "author": {
    "name": "Kevin Dean",
    "email": "Kevin.Dean@datadevelopment.com",
    "url": "https://www.linkedin.com/in/kdean"
  },
  "scripts": {
    "lint": "eslint",
    "tsc-src": "tsc --project tsconfig-src.json",
    "build:non-prod": "rimraf dist tsconfig-src.tsbuildinfo && npm run tsc-src -- --declarationMap --sourceMap",
    "build:alpha": "npm run build:non-prod && tsc --project tsconfig-config.json --noEmit",
    "build:beta": "npm run build:non-prod",
    "build:prod": "npm run tsc-src -- --noEmit && tsup --tsconfig tsconfig-tsup.json",
    "build:doc": "npm run build:non-prod",
    "generate-locale-resources": "tsx src/generator/locale-resources-generator.ts"
  },
  "devDependencies": {
    "@aidc-toolkit/dev": "^2.0.0-alpha"
  },
  "dependencies": {
    "@aidc-toolkit/core": "^2.0.0-alpha",
    "@aidc-toolkit/gs1": "^2.0.0-alpha",
    "@aidc-toolkit/utility": "^2.0.0-alpha"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  }
}
